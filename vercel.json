{
  "version": 2,
  "builds": [
    {
      "src": "app/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "penjelasan.md",
          "app/public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/server.js"
    }
  ]
}
