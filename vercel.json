{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "app/**",
          "penjelasan.md",
          "node_modules/sql.js/dist/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.(?:js|css|ico|png|jpg|jpeg|svg|woff2?|ttf))",
      "dest": "/app/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/app/public/index.html"
    }
  ]
}
